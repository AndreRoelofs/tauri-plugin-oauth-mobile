# Copy to `.env` (or `.env.local`) before running the example.
# Vite exposes any variable prefixed with `VITE_` to the browser bundle.

# --- Google OAuth -----------------------------------------------------------
# Register an OAuth 2.0 Client ID in Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
#
# Pick the platform that matches the device you're targeting:
#   - "iOS"     -> redirect URI is `com.googleusercontent.apps.<id>:/oauth2redirect`
#   - "Android" -> redirect URI is `com.googleusercontent.apps.<id>:/oauth2redirect`
#                  with the SHA-1 of your Android app's signing certificate.
#
# The redirect scheme below MUST also be registered with the host platform:
#   - iOS:     CFBundleURLSchemes in Info.plist
#   - Android: `appAuthRedirectScheme` manifestPlaceholder in app/build.gradle
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=

# --- Duende IdentityServer demo --------------------------------------------
# A public OIDC sandbox at https://demo.duendesoftware.com — no signup needed.
# The defaults below match the public `interactive.public` client configured
# with the standard native redirect URI; override only if you need to.
VITE_DUENDE_CLIENT_ID=interactive.public
VITE_DUENDE_REDIRECT_URI=io.identitymodel.native://callback
